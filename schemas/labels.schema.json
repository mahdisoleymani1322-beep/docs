{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "labels.schema.json",
  "title": "برچسب انسانی گلدن‌ست (evals/golden/<type>/labels.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["doc_type", "items"],
  "properties": {
    "doc_type": {"enum": ["proposal", "pitch", "catalog"]},
    "items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["doc", "claims", "expected", "reason", "labeled_by", "date"],
        "properties": {
          "doc": {"type": "string"},
          "claims": {"type": ["string", "null"]},
          "expected": {
            "type": "object", "additionalProperties": false, "required": ["guide_pass", "veto", "checks_fail"],
            "properties": {
              "guide_pass": {"type": "boolean"},
              "veto": {"type": "array", "items": {"type": "string", "pattern": "^V[0-9]{2}$"}},
              "checks_fail": {"type": "array", "items": {"type": "string", "pattern": "^CHK-[A-Z0-9-]+$"}},
              "rows": {"type": ["object", "null"], "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 4}}
            }
          },
          "reason": {"type": "string", "minLength": 5},
          "labeled_by": {"type": "string"},
          "date": {"type": "string"}
        }
      }
    }
  }
}
