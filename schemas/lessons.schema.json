{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lessons.schema.json",
  "title": "حافظه‌ی درس‌ها (lessons/lessons.json) — lessons.py",
  "type": "object",
  "additionalProperties": false,
  "required": ["lessons"],
  "properties": {
    "lessons": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "agent", "text", "source_run", "source_kind", "created", "active"],
        "properties": {
          "id": {"type": "string", "pattern": "^L-[0-9]{3}$"},
          "agent": {"enum": ["intake-analyst", "strategist", "researcher", "writer", "judge-rubric", "judge-claims", "judge-veto"]},
          "text": {"type": "string", "minLength": 10, "maxLength": 200},
          "source_run": {"type": "string"},
          "source_kind": {"enum": ["loop", "feedback"]},
          "created": {"type": "string"},
          "active": {"type": "boolean"},
          "retired_reason": {"type": ["string", "null"]}
        }
      }
    }
  }
}
