{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claims.schema.json",
  "title": "دفتر ادعا (claims.json) — researcher",
  "description": "fact بدون source مجاز نیست. منبع input باید به فیلد یا پاسخ غیرخالی، و منبع url به نشانی موجود در searches اشاره کند (چک متقاطع در validate.py).",
  "type": "object",
  "additionalProperties": false,
  "required": ["claims", "searches"],
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "text", "type", "source", "used_in", "limits", "impact"],
        "properties": {
          "id": {"type": "string", "pattern": "^C-[0-9]{2}$"},
          "text": {"type": "string", "minLength": 3},
          "type": {"enum": ["fact", "assumption", "target"]},
          "source": {
            "type": ["object", "null"], "additionalProperties": false, "required": ["kind", "ref"],
            "properties": {
              "kind": {"enum": ["input", "url", "attachment"]},
              "ref": {"type": "string", "minLength": 1},
              "date": {"type": ["string", "null"]},
              "quote": {"type": ["string", "null"]}
            }
          },
          "used_in": {"type": "array", "items": {"type": "string", "pattern": "^S[0-9]{2}$"}},
          "limits": {"type": "string"},
          "impact": {"enum": ["price", "scope", "commitment", "none"]}
        },
        "if": {"properties": {"type": {"const": "fact"}}},
        "then": {"properties": {"source": {"type": "object"}}}
      }
    },
    "searches": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["query", "urls"],
        "properties": {"query": {"type": "string", "minLength": 2}, "urls": {"type": "array", "items": {"type": "string"}}}
      }
    }
  }
}
